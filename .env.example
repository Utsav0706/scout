# Copy to .env and fill in. Never commit .env.

# LLM providers (needed from M4)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web search (needed from M3) - free tier at tavily.com
TAVILY_API_KEY=

# Tracing (needed from M8) - free Hobby tier at cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LOG_LEVEL=INFO
CONFIG_PATH=config.yaml
