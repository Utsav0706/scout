# Copy to .env and fill in. Never commit .env.

# Database. Default matches docker-compose.yml when the API runs on your machine.
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout

# Background jobs. rq needs Redis + a worker (docker compose); inline runs jobs inside
# the API process (local dev on Windows, where RQ workers can't run).
REDIS_URL=redis://localhost:6379/0
JOBS_MODE=rq

# Signs login tokens. At least 32 characters. Generate one with:
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# LLM providers (needed from M4)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web search (needed from M3) - free tier at tavily.com
TAVILY_API_KEY=

# Tracing (needed from M8) - free Hobby tier at cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LOG_LEVEL=INFO
CONFIG_PATH=config.yaml
